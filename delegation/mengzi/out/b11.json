      "para_index": 34,
      "domains": [
        "V"
      ],
      "modes": [
        "proposition"
      ],
      "reason": "「堯之於舜也，使其子九男事之」以堯養舜為尊賢之禮；同段「非養君子之道也」論王公之尊賢之群體之義"
    },
    {
