      "para_index": 25,
      "domains": [
        "V"
      ],
      "modes": [
        "proposition"
      ],
      "reason": "「諸侯失國，而後託於諸侯，禮也；士之託於諸侯，非禮也」立士之託諸侯之禮"
    },
    {
