      "para_index": 30,
      "domains": [
        "V"
      ],
      "modes": [
        "proposition"
      ],
      "reason": "「抱關擊柝者，皆有常職以食於上。無常職而賜於上者，以為不恭也」以常職否則立餽受之禮"
    },
