          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "曾子將行晏子送之而贈以善言第二十三",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子之晉睹齊累越石父解左驂贖之與歸第二十四",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子之御感妻言而自抑損晏子薦以為大夫第二十五",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "泯子午見晏子晏子恨不盡其意第二十六",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子遺北郭騷米以養母騷殺身以明晏子之賢第二十七",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公欲見高糾晏子辭以祿仕之臣第二十八",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "高糾治晏子家不得其俗乃逐之第二十九",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子居喪遜答家老仲尼善之第三十",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "仲尼見景公，景公欲封之，晏子以為不可第一",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公上路寢，聞哭聲，問，梁丘據、晏子對第二",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "仲尼見景公，景公曰：先生奚不見寡人宰乎第三",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "仲尼之齊見景公而不見，晏子子貢致問第四",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公出田，顧問晏子：若人之眾有孔子乎第五",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "仲尼相魯，景公患之，晏子對以勿憂第六",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問有臣有兄弟而強足恃乎，晏子對不足恃第七",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公游牛山，少樂，請晏子一願第八",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公為大鐘，晏子與仲尼、柏常騫知將毀第九",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "田無宇非晏子有老妻，晏子對以去老謂之亂第十",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "工女欲入身于晏子，晏子辭不受第十一",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公欲誅羽人，晏子以為法不宜殺第十二",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公謂晏子，東海之中有水而赤，晏子詳對第十三",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問天下有極大極細，晏子對第十四",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "莊公圖莒，國人擾，紿以晏子在，乃止第十五",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子死，景公馳往哭，哀畢而去第十六",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子死，景公哭之，稱：莫復陳告吾過第十七",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子沒，左右諛，弦章諫，景公賜之魚第十八",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "靈公禁婦人為丈夫飾不止晏於請先內勿服第一",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "齊人好轂擊晏子紿以不祥而禁之第二",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公瞢五丈夫稱無辜晏子知其冤第三",
          "para_indexes": [
            1
          ]
        }
