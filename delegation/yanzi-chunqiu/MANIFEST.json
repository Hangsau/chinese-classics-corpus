    },
    {
      "file": "b06.md",
      "chapters": [
        {
          "chapter": "柏常騫禳梟死將為景公請壽晏子識其妄第四",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公成柏寢而師開言室夕晏子辨其所以然第五",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公病水瞢與日鬥晏子教占瞢者以對第六",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公病瘍晏子撫而對之乃知群臣之野第七",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子使吳吳王命儐者稱天子晏子詳惑第八",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子使楚楚為小門晏子稱使狗國者入狗門第九",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "楚王欲辱晏子指盜者為齊人晏子對以橘第十",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "楚王饗晏子進橘置削晏子不剖而食第十一",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子布衣棧車而朝田桓子侍景公飲酒請浮之第十二",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "田無宇請求四方之學士晏子謂君子難得第十三",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "田無宇勝奕氏高氏欲分其家晏子使致之公第十四",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "子尾疑晏子不受慶氏之邑晏子謂足欲則亡第十五",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公祿晏子平陰與槁邑晏子願行三言以辭第十六",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "梁丘據言晏子食肉不足景公割地將封晏子辭第十七",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公以晏子食不足致千金而晏子固不受第十八",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公以晏子衣食弊薄使田無宇致封邑晏子辭第十九",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "田桓子疑晏子何以辭邑晏子答以君子之事也第二十",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公欲更晏子宅晏子辭以近市得所求諷公省刑第二十一",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公毀晏子鄰以益其宅晏子因陳桓子以辭第二十二",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公欲為晏子築室于宮內晏子稱是以遠之而辭第二十三",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公以晏子妻老且惡欲納愛女晏子再拜以辭第二十四",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公以晏子乘弊車駑馬使梁丘據遺之三返不受第二十五",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公睹晏子之食菲薄而嗟其貧晏子稱其參士之食第二十六",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "梁丘據自患不及晏子晏子勉據以常為常行第二十七",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子老辭邑景公不許致車一乘而後止第二十八",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子病將死，妻問所欲言，云毋變爾俗第二十九",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子病將死鑿楹納書命子壯而示之第三十",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問何修則夫先王之游晏子對以省耕實第一",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問桓公何以致霸晏子對以下賢以身第二",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問欲逮桓公之後晏子對以任非其人第三",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問廉政而長久晏子對以其行水也第四",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問為臣之道晏子對以九節第五",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問賢不肖可學乎晏子對以勉強為上第六",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問富民安眾晏子對以節欲中聽第七",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問國如何則謂安晏子對以內安政外歸義第八",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "景公問諸侯孰危晏於對以莒其先亡第九",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子使吳吳王問可處可去晏子對以視國治亂第十",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "吳王問保威強不失之道晏子對以先民後身第十一",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "晏子使魯魯君問何事回曲之君晏子對以庇族第十二",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "魯昭公問魯一國迷何也晏子對以化為一心第十三",
          "para_indexes": [
            1
          ]
        },
        {
          "chapter": "魯昭公問安國眾民晏子對以事大養小謹聽節斂第十四",
          "para_indexes": [
