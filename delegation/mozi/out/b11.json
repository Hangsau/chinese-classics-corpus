  "rows": [
    {"chapter": "經說下", "para_index": 1, "domains": [], "modes": ["formalization"], "reason": "「彼以此其然也」與「我以此其不然也」用同一命題的肯否說明止與疑，是抽象判定論式，未落到人的生活問題"},
    {"chapter": "經說下", "para_index": 2, "domains": [], "modes": ["formalization"], "reason": "「謂四足獸，與牛馬，與物」到「則俱爲麋」檢驗類名包含與錯誤推論，牛馬麋只是分類材料"},
    {"chapter": "經說下", "para_index": 3, "domains": [], "modes": ["formalization"], "reason": "「同名，俱鬭，不俱二」並列白馬、屨等語例，辨析同名與述謂關係，名詞換成中性項仍可推演"},
    {"chapter": "經說下", "para_index": 4, "domains": [], "modes": ["formalization"], "reason": "「有文實也，而後謂之；無文實也，則無謂也」處理一、多與命名述謂，是名實論式而非自我認同主張"},
    {"chapter": "經說下", "para_index": 5, "domains": [], "modes": ["formalization"], "reason": "「一二不相盈，廣脩、堅白」把見與不見、數與屬性壓成關係條目，沒有說出人的處境或價值"},
    {"chapter": "經說下", "para_index": 6, "domains": [], "modes": ["formalization"], "reason": "「舉重不與箴，非力之任也」與「非智之任也」用負荷例界定能力所及，屬技術性能力辨析"},
    {"chapter": "經說下", "para_index": 7, "domains": [], "modes": ["formalization"], "reason": "「木與夜孰長？智與粟孰多？」羅列不可直接比較的尺度，重點是範疇錯置，不是對智慧、親疏或身分下主張"},
    {"chapter": "經說下", "para_index": 8, "domains": [], "modes": ["formalization"], "reason": "「假必非也，而後假」以狗與霍說明假借成立的語義條件，是命名規則"},
    {"chapter": "經說下", "para_index": 9, "domains": [], "modes": ["formalization"], "reason": "「見之，智也。告之，使智也」把見、知、告知列為認知關係的定義條，未描寫有人如何認識或生活"},
    {"chapter": "經說下", "para_index": 10, "domains": [], "modes": ["formalization"], "reason": "「舉之則輕，廢之則重」等反常例用來判疑與愚，「以已爲然也與」仍是認知判準的論式材料"},
    {"chapter": "經說下", "para_index": 11, "domains": [], "modes": ["formalization"], "reason": "「數牛數馬則牛馬二，數牛馬則牛馬一」辨析集合與計數單位，屬形式分類"},
    {"chapter": "經說下", "para_index": 12, "domains": [], "modes": ["formalization"], "reason": "「宇南北在旦，有在莫，宇徙久」說空間位置隨時間遷移的關係，是時空條目"},
    {"chapter": "經說下", "para_index": 13, "domains": [], "modes": ["formalization"], "reason": "「堯善治，自今在諸古也」以堯作例說明古今指涉，換成別的事件仍成立，並非治世或領導主張"},
    {"chapter": "經說下", "para_index": 14, "domains": [], "modes": ["formalization"], "reason": "「光至景亡」說明光與影消長，是光學條目"},
    {"chapter": "經說下", "para_index": 15, "domains": [], "modes": ["formalization"], "reason": "「景二，光夾。一，光一」形式化光源數量與成影數量的關係"},
    {"chapter": "經說下", "para_index": 16, "domains": [], "modes": ["formalization"], "reason": "「足蔽下光，故成景於上；首蔽上光，故成景於下」解釋小孔成像倒置；「光之人」是光學用語，不是在談人"},
    {"chapter": "經說下", "para_index": 17, "domains": [], "modes": ["formalization"], "reason": "「日之光反燭人，則景在日與人之閒」只規定反射光下影的位置，是光學關係"},
    {"chapter": "經說下", "para_index": 18, "domains": [], "modes": ["formalization"], "reason": "「木杝景短大，木正景長小」比較物體傾正、距離與影像大小，是光學規則"},
    {"chapter": "經說下", "para_index": 19, "domains": [], "modes": ["formalization"], "reason": "「鑒景當俱，就去亦當俱」逐項說鏡面、物與像的方向和位置，屬鏡像形式化"},
    {"chapter": "經說下", "para_index": 20, "domains": [], "modes": ["formalization"], "reason": "「近中則所鑒大，景亦大；遠中則所鑒小」分鏡中內外推算像的大小與正倒，是幾何光學"},
    {"chapter": "經說下", "para_index": 21, "domains": [], "modes": ["formalization"], "reason": "「鑒者近則所鑒大，景亦大」以距離規定鏡像大小，通篇未離開光學"},
    {"chapter": "經說下", "para_index": 22, "domains": [], "modes": ["formalization"], "reason": "「權重相若也，相衡則本短標長」計算衡木、權重與本標長短的平衡，是槓桿力學"},
    {"chapter": "經說下", "para_index": 23, "domains": [], "modes": ["formalization"], "reason": "「繩直權重相若，則正矣」說繩、權重與升降所得的力學條件，是提挈裝置的規則"},
    {"chapter": "經說下", "para_index": 24, "domains": [], "modes": ["formalization"], "reason": "「兩輪爲輲，車梯也」以下逐項列載重、引軲與倚拒條件，是車梯受力規格"},
    {"chapter": "經說下", "para_index": 25, "domains": [], "modes": ["formalization"], "reason": "「膠絲去石，挈也。絲絕，引也」用方石與絲的狀態界定柱、挈、引、收，是力學名目表"},
    {"chapter": "經說下", "para_index": 26, "domains": [], "modes": ["formalization"], "reason": "「刀輕則糴不貴，刀重則糴不易」形式化貨幣輕重與糴價的相對變化，未另論人的工作或社會關係"},
    {"chapter": "經說下", "para_index": 27, "domains": [], "modes": ["formalization"], "reason": "「其所以不讐去，則讐」以鬻室嫁子等作交易例，界定價格、欲求與成交條件，重點是關係式"},
    {"chapter": "經說下", "para_index": 28, "domains": [], "modes": ["formalization"], "reason": "「子在軍，不必其死生；聞戰，亦不必其死生」用戰訊與懼作未知狀態的例證，落點是不能由消息必推死生"},
    {"chapter": "經說下", "para_index": 29, "domains": [], "modes": ["formalization"], "reason": "「始也謂此南方，故今也謂此南方」說位置改變後仍沿用舊稱的指涉錯誤，是方位論式"},
    {"chapter": "經說下", "para_index": 30, "domains": [], "modes": ["formalization"], "reason": "「或謂之狗，其或謂之犬」先辨同異名，再以「當者勝」定辯，是語詞與判定規則"},
    {"chapter": "經說下", "para_index": 31, "domains": [], "modes": ["formalization"], "reason": "「酒未讓，始也，不可讓也」用讓酒說明動作未始時的否定條件，是時態語義例"},
    {"chapter": "經說下", "para_index": 32, "domains": [], "modes": ["formalization"], "reason": "「石一也，堅白二也，而在石」處理一物、多屬性與知不知的關係，是堅白論式"},
    {"chapter": "經說下", "para_index": 33, "domains": [], "modes": ["formalization"], "reason": "「謂有智焉，有不智焉」反覆檢驗指稱能否只落在已知項，屬指示與知識範圍的形式辨析"},
    {"chapter": "經說下", "para_index": 34, "domains": [], "modes": ["formalization"], "reason": "「逃臣，不智其處。狗犬，不智其名也」並列處所、名稱與失物作不可指稱的例子，沒有實質君臣或認同主張"},
    {"chapter": "經說下", "para_index": 35, "domains": [], "modes": ["formalization"], "reason": "「智狗不智犬，重則過，不重則不過」用同物異名測試知識述謂是否重複，是語義論式"},
    {"chapter": "經說下", "para_index": 36, "domains": [], "modes": ["formalization"], "reason": "「孰，何謂也」與未問便答的例子界定問答歧義和應答時機，「兵人長」只是量詞語例"},
    {"chapter": "經說下", "para_index": 37, "domains": [], "modes": ["formalization"], "reason": "「一主存者以問所存，一主所存以問存者」區分處所與在者兩種問法，是指涉結構"},
    {"chapter": "經說下", "para_index": 38, "domains": [], "modes": ["formalization"], "reason": "「合水土火，火離然」及「識麋與魚之數」處理合離與分類計數，材料可換而形式不變"},
    {"chapter": "經說下", "para_index": 39, "domains": [], "modes": ["formalization"], "reason": "「欲惡傷生損壽」與「若酒之於人也」把欲惡、利害當作關係例來檢驗能否相連，未描寫某人的內在生活或身體處境"},
    {"chapter": "經說下", "para_index": 40, "domains": [], "modes": ["formalization"], "reason": "「飽者去餘，適足不害」用去餘、傷麋與瘧病辨析損後可益，重點是損益概念而非疾病經驗"},
    {"chapter": "經說下", "para_index": 41, "domains": [], "modes": ["formalization"], "reason": "「以目見，而目以火見，而火不見」分解視覺媒介與認知路徑，是認知能力的技術條"},
    {"chapter": "經說下", "para_index": 42, "domains": [], "modes": ["formalization"], "reason": "「見火謂火熱也，非以火之熱我有」區分看見火、判知熱與自身受熱，是感知推論例"},
    {"chapter": "經說下", "para_index": 43, "domains": [], "modes": ["formalization"], "reason": "「雜所智與所不智而問之」測試混合已知與未知項時的回答，屬知識邏輯"},
    {"chapter": "經說下", "para_index": 44, "domains": [], "modes": ["formalization"], "reason": "「有之而后無」與「無之而無」區別由有轉無和本來即無，是存在詞的形式條目"},
    {"chapter": "經說下", "para_index": 45, "domains": [], "modes": ["formalization"], "reason": "「臧也今死，而春也得之又死也」用兩個時間點的死作命題可能性例，並未把死亡本身當主題"},
    {"chapter": "經說下", "para_index": 46, "domains": [], "modes": ["formalization"], "reason": "「且必然，且已必已」及「用工而後已」界定將然、完成與條件先後，是模態規則"},
    {"chapter": "經說下", "para_index": 47, "domains": [], "modes": ["formalization"], "reason": "「縣輕而髮絕，不均也」用懸髮是否斷裂檢驗均衡，是物理判準"},
    {"chapter": "經說下", "para_index": 48, "domains": [], "modes": ["formalization"], "reason": "「或以名視人，或以實視人」以堯、友與臛辨名實指涉；焦點是名與實的論式，不作自我或人物評價"},
    {"chapter": "經說下", "para_index": 49, "domains": [], "modes": ["formalization"], "reason": "「狗，犬也，而殺狗謂之殺犬」檢驗同義名替換後述句是否成立，是語義等值例"},
    {"chapter": "經說下", "para_index": 50, "domains": [], "modes": ["formalization"], "reason": "「令使也」以下反覆置換我、殿與使，辨析使令句的施受關係，是語法條目"},
    {"chapter": "經說下", "para_index": 51, "domains": [], "modes": ["formalization"], "reason": "「荆之具也，則沈淺非荆淺也」區分器具屬性與整體屬性，荆與沈只是推例"},
    {"chapter": "經說下", "para_index": 52, "domains": [], "modes": ["formalization"], "reason": "「見之，其於意也，不易先智」以楹的摶與輕重說感知和先有意象的差別，是認知論式"},
    {"chapter": "經說下", "para_index": 53, "domains": [], "modes": ["formalization"], "reason": "「段、椎俱事於履，可用也」比較工具用途與製屨工序的先後，屬功能關係例"},
    {"chapter": "經說下", "para_index": 54, "domains": [], "modes": ["formalization"], "reason": "「五有一焉，一有五焉，十二焉」濃縮部分、整體與數的包含關係，是純形式條"},
    {"chapter": "經說下", "para_index": 55, "domains": [], "modes": ["formalization"], "reason": "「𣃈必半」並以端、中、前後取界定切半成立的條件，是幾何分割規則"},
    {"chapter": "經說下", "para_index": 56, "domains": [], "modes": ["formalization"], "reason": "「已給則當給，不可無也」連同「久有窮、無窮」處理可無與時限的模態，是抽象條件式"},
    {"chapter": "經說下", "para_index": 57, "domains": [], "modes": ["formalization"], "reason": "「無所處而不中縣，摶也」以懸置與居中界定正，是幾何位置定義"},
    {"chapter": "經說下", "para_index": 58, "domains": [], "modes": ["formalization"], "reason": "「進行者先敷近，後敷遠」在傴宇中說運動依次占據近遠位置，是時空形式化"},
    {"chapter": "經說下", "para_index": 59, "domains": [], "modes": ["formalization"], "reason": "「必先近而後遠」把遠近歸於脩、先後歸於久；「民行」只是移動例，不是人生行動主張"},
    {"chapter": "經說下", "para_index": 60, "domains": [], "modes": ["formalization"], "reason": "「俱有法而異，或木或石，不害其方」說同形之物可異材，形式與材料可替換"},
    {"chapter": "經說下", "para_index": 61, "domains": [], "modes": ["formalization"], "reason": "「牛有齒、馬有尾」不能證牛馬不類，條目明指「狂舉」，是在拆解偏舉的分類謬誤"},
    {"chapter": "經說下", "para_index": 62, "domains": [], "modes": ["formalization"], "reason": "「牛不二，馬不二，而牛馬二」檢驗複合類名能否述爲牛或馬，是集合分類論式"},
    {"chapter": "經說下", "para_index": 63, "domains": [], "modes": ["formalization"], "reason": "「彼彼止於彼，此此止於此」以彼此置換檢驗正名和指示範圍，是指稱規則"},
    {"chapter": "經說下", "para_index": 64, "domains": ["VIII"], "modes": ["proposition"], "reason": "「智少而不學，必寡」明說知識少而不學必更寡；「智而不教，適息」又說有知而不教會使學習止息，直接主張學與教的後果"},
    {"chapter": "經說下", "para_index": 65, "domains": [], "modes": ["formalization"], "reason": "「外，親智也；室中，說智也」區分親見所得與由言說所得，並用色若白黑檢驗推知，是認知形式化"},
    {"chapter": "經說下", "para_index": 66, "domains": [], "modes": ["formalization"], "reason": "「之人之言可，是不誖」與「之人之言不可」檢驗一句話的可否和自相違背，是命題一致性條目"},
    {"chapter": "經說下", "para_index": 67, "domains": [], "modes": ["formalization"], "reason": "「彼若不惟其謂，則不行也」辨析說者是否承擔自己所謂與命題能否行，是語用論式"},
    {"chapter": "經說下", "para_index": 68, "domains": [], "modes": ["formalization"], "reason": "「有窮則可盡，無窮則不可盡」把人、愛置入有限無限與能否遍及的量化推演；換成中性集合與關係仍成立"},
    {"chapter": "經說下", "para_index": 69, "domains": [], "modes": ["formalization"], "reason": "「不智其數」而可「智愛之盡之」區分不知道總數與知道全稱遍及，愛民是量詞推理的材料"},
    {"chapter": "經說下", "para_index": 70, "domains": ["VII"], "modes": ["proposition"], "reason": "「仁，愛也。義，利也」直接界定仁與義的實質內容，並以愛、所愛及利、所利駁仁內義外，德目不可換成中性項而不失主張"},
    {"chapter": "經說下", "para_index": 71, "domains": ["VIII"], "modes": ["proposition"], "reason": "「故告之也。是使智學之無益也，是教也」指出宣稱學無益仍須藉教使人知，因而以實際教學駁斥學習無益，主題承重在學與教"},
    {"chapter": "經說下", "para_index": 72, "domains": [], "modes": ["formalization"], "reason": "「以理之可誹」而不以誹議多少判可否，末以「長論短」指出尺度錯置，是評議有效性的論式"},
    {"chapter": "經說下", "para_index": 73, "domains": [], "modes": ["formalization"], "reason": "「己之誹也不非」與「不可非也，是不非誹也」處理誹與非的自指和否定層次，是語義練習"},
    {"chapter": "經說下", "para_index": 74, "domains": [], "modes": ["formalization"], "reason": "「莫長於是，莫短於是」再平行到「是之是也，非是也者」，以長短演示真假極值，是形式類比"},
    {"chapter": "經說下", "para_index": 75, "domains": [], "modes": ["formalization"], "reason": "「高下以善不善爲度，不若山澤」區分價值性的高下與地勢高下，再用稱謂倒轉驗證語義，並非勸人居上或處下"},
    {"chapter": "經說下", "para_index": 76, "domains": [], "modes": ["formalization"], "reason": "「是不之，則是而不之焉」反覆置換是、不、之來檢驗肯否自指，屬純命題論式"}
  ]
